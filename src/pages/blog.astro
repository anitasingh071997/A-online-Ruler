</style>

<script>
	const themeToggle = document.querySelector<HTMLButtonElement>('#blog-theme-toggle')!;
	let theme = 'light';
	try { theme = localStorage.getItem('aor-theme') === 'dark' ? 'dark' : 'light'; } catch { /* Keep the theme available for this visit. */ }
	function setTheme(nextTheme: string) {
		theme = nextTheme;
		document.documentElement.dataset.theme = theme;
		const dark = theme === 'dark';
		themeToggle.setAttribute('aria-checked', String(dark));
		themeToggle.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
		themeToggle.title = dark ? 'Switch to light mode' : 'Switch to dark mode';
		document.querySelector<HTMLElement>('#blog-theme-icon')!.textContent = dark ? '☾' : '☀';
		document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')?.setAttribute('content', dark ? '#111419' : '#fafbfd');
		try { localStorage.setItem('aor-theme', theme); } catch { /* Keep the theme active for this visit. */ }
	}
	setTheme(theme);
	themeToggle.addEventListener('click', () => setTheme(theme === 'dark' ? 'light' : 'dark'));
</script>
