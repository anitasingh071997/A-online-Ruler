	.featured-guide{display:grid;grid-template-columns:190px minmax(0,1fr);gap:32px;padding:32px 0 45px;border-top:1px solid var(--blog-line)}.featured-guide-label{display:flex;align-items:center;gap:8px;height:max-content;padding-top:8px;color:#70839a;font:600 9px ui-monospace,monospace;letter-spacing:.08em}.featured-dot{width:7px;height:7px;border-radius:50%;background:#397ff0}.featured-rule{width:20px;height:1px;background:#cfd9e6}
	.article-body{max-width:680px}.article-heading{display:flex;align-items:flex-start;gap:15px}.article-number{flex:none;display:grid;place-items:center;width:34px;height:34px;border:1px solid #dce7f5;border-radius:9px;background:#f0f6ff;color:#397ff0;font:11px ui-monospace,monospace}.article-heading .blog-kicker{margin:2px 0 8px}.article-heading h2{margin:0;color:#172334;font-size:26px;line-height:1.17;letter-spacing:-.04em}.article-lead{margin:16px 0 22px;color:#42566e;font-size:15px;line-height:1.75}.article-body h3{margin:22px 0 7px;color:#263a52;font-size:15px;letter-spacing:-.015em}.article-body>p:not(.article-lead){margin:0 0 14px;color:#59697d;font-size:13px;line-height:1.8}.article-body>p a{color:#2267c5;text-decoration-thickness:1px;text-underline-offset:3px}.article-callout{display:flex;gap:11px;margin:22px 0;padding:14px 15px;border:1px solid #d8e7fa;border-radius:10px;background:linear-gradient(110deg,#edf5ff,#fff)}.article-callout>span{flex:none;display:grid;place-items:center;width:20px;height:20px;border:1px solid #b8d1f1;border-radius:50%;color:#397ff0;font:12px Georgia,serif}.article-callout p{margin:0;color:#52667f;font-size:12px;line-height:1.65}.article-action{display:inline-flex;align-items:center;gap:9px;margin-top:5px;color:#2267c5;font-size:12px;font-weight:700;text-decoration:none}.article-action:hover{color:#144f9c}.article-list{display:grid;grid-template-columns:1fr 1fr;gap:40px 36px;padding:36px 0 70px;border-top:1px solid var(--blog-line)}.compact-article{padding:7px 0}.compact-article .article-heading h2{font-size:21px}.compact-article .article-lead{font-size:13px}.blog-endcap{display:flex;align-items:center;justify-content:space-between;gap:24px;margin:0 0 55px;padding:27px 30px;border:1px solid #dce7f5;border-radius:15px;background:linear-gradient(105deg,#eef5ff,#fff)}.blog-endcap h2{margin:8px 0 5px;font-size:21px;letter-spacing:-.035em}.blog-endcap p{margin:0;color:#68788e;font-size:12px;line-height:1.6}.blog-endcap .blog-header-cta{flex:none}
