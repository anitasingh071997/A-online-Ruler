	.blog-header-cta{display:inline-flex;align-items:center;justify-content:space-between;gap:15px;min-height:38px;margin-left:auto;padding:0 13px;border:1px solid #397ff0;border-radius:8px;background:#397ff0;color:#fff;font-size:12px;font-weight:650;text-decoration:none;box-shadow:0 5px 13px #397ff027}.blog-header-cta:hover{background:#246bdc}.blog-header .site-theme-switch{margin-left:0}
