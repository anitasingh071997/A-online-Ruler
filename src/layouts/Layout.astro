---
import '../styles/global.css';

interface Props {
	 title?: string;
	 description?: string;
	 canonical?: string;
	robots?: string;
}

const {
	 title = 'Online Ruler — Free Inches, CM & MM Screen Ruler | A Online Ruler',
	 description = 'Use a free online ruler in inches, centimeters and millimeters. Calibrate your screen for actual-size measurements on your phone, tablet or computer.',
	 canonical = 'https://aonlineruler.com/',
	robots = 'index,follow,max-image-preview:large',
} = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#fafafa" />
		<meta name="description" content={description} />
		<meta name="robots" content={robots} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="A Online Ruler" />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:image" content="https://aonlineruler.com/og-image.png" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Online ruler with inch, centimeter and millimeter markings" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content="https://aonlineruler.com/og-image.png" />
		<meta name="twitter:image:alt" content="Online ruler with inch, centimeter and millimeter markings" />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-EM32LYCCYJ"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){window.dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-EM32LYCCYJ');
		</script>
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
