---
import Layout from '../layouts/Layout.astro';
import { faqItems, faqStructuredData } from '../data/faq';
import LanguageSelector from './LanguageSelector.astro';

interface Props { locale?: string; }
const { locale = 'en' } = Astro.props;
---

<Layout
	title="Online Ruler – Free Actual-Size Inches, CM & MM Tool | A Online Ruler"
	description="Use a free online ruler in inches, cm, and mm. Calibrate your screen for an actual-size scale on phone, tablet, or computer. No download required."
	locale={locale}
	canonical={`https://aonlineruler.com/${locale === 'en' ? '' : `${locale}/`}`}
>
	<div class="home-shell">
		<a class="skip-link" href="#top">Skip to main content</a>
		<header class="home-topbar">
			<a class="brand" href="/" aria-label="A Online Ruler home">
				<img class="brand-logo" src="/favicon.svg" alt="" aria-hidden="true" />
				<span>A Online Ruler</span>
			</a>
			<nav aria-label="Main navigation">
				<details class="home-category-menu">
					<summary><span>Tools</span><svg viewBox="0 0 12 12" aria-hidden="true"><path d="m3 4.5 3 3 3-3" /></svg></summary>
					<div class="home-category-dropdown">
						<a href="/classroom-management-tools">Classroom Management Tools</a>
						<a href="/random-tools">Random Tools</a>
						<a href="/measurement">Measurement</a>
						<a href="/facebook-editor-utilities">Facebook Editor Utilities</a>
						<a href="/emoji-symbols">Emoji &amp; Symbols</a>
						<a href="/time-and-date">Time And Date</a>
						<a href="/utilities">Utilities</a>
						<a href="/travel">Travel</a>
						<a href="/text-tool">Text Tool</a>
						<a href="/programming">Programming</a>
						<a href="/lifestyle">Lifestyle</a>
						<a href="/blog">Blog</a>
					</div>
				</details>
				<a href="/ruler#popular-tools">Popular Tools</a>
				<a href="/about-us">About</a>
				<a href="/contact-us">Contact</a>
				<a href="#faq">FAQs</a>
			</nav>
			<a class="home-header-cta" href="/ruler">Open the ruler <span aria-hidden="true">→</span></a>
			<button class="home-theme-switch site-theme-switch" id="home-theme-toggle" type="button" role="switch" aria-checked="false" aria-label="Light mode" title="Light mode">
				<span class="home-theme-switch-track" aria-hidden="true">
					<span class="home-theme-mark home-theme-sun">☀</span>
					<span class="home-theme-mark home-theme-moon">☾</span>
					<span class="home-theme-thumb"><span id="home-theme-icon">☀</span></span>
				</span>
			</button>
		</header>

		<main id="top" class="home-main">
			<div class="home-top-controls" aria-label="Page settings">
				<LanguageSelector locale={locale} currentPath={Astro.url.pathname} />
			</div>

			<div class="homepage-content" id="online-ruler-homepage">
			<section class="home-hero" aria-labelledby="home-title">
				<div class="eyebrow">A SIMPLE TOOL FOR EVERYDAY MEASUREMENTS</div>
				<h1 id="home-title">Free Online Ruler for Screen Measurements</h1>
				<p>Use your phone, tablet, or computer as a calibrated online ruler. Open the full ruler workspace to measure in centimeters, inches, or pixels.</p>
				<div class="home-hero-actions">
					<a class="home-cta" href="/ruler">Open the ruler workspace <span aria-hidden="true">→</span></a>
					<a class="home-secondary-cta" href="/calibration">Calibrate your display <span aria-hidden="true">↗</span></a>
				</div>
			</section>

			<section class="home-features" aria-labelledby="features-title">
				<div class="eyebrow">WHAT YOU CAN DO</div>
				<h2 id="features-title">A clear workspace for quick checks.</h2>
				<div class="home-feature-grid">
					<a class="home-feature-card" href="/ruler"><span class="feature-index" aria-hidden="true">01</span><h3>Measure at any edge</h3><p>Place rulers on the top, bottom, left, or right side of your screen.</p></a>
					<a class="home-feature-card" href="/calibration"><span class="feature-index" aria-hidden="true">02</span><h3>Calibrate your display</h3><p>Use a device preset, screen size, or standard card for a closer scale.</p></a>
					<a class="home-feature-card" href="/ruler"><span class="feature-index" aria-hidden="true">03</span><h3>Click for coordinates</h3><p>Drop a crosshair in the open workspace and read its position in your chosen unit.</p></a>
				</div>
			</section>

			<section class="home-guide" aria-labelledby="guide-title">
				<div class="eyebrow">A PRACTICAL ONLINE TOOL</div>
				<h2 id="guide-title">Start measuring in seconds.</h2>
				<p>Open the ruler workspace, choose a unit, and calibrate the screen when accuracy matters. The ruler runs in your browser with no download or account.</p>
				<a class="home-cta" href="/ruler">Go to the full measuring workspace <span aria-hidden="true">↗</span></a>
			</section>


			<section class="home-seo-guide" aria-labelledby="home-seo-title">
				<div class="eyebrow">YOUR SCREEN, A HANDY MEASURING TOOL</div>
				<h2 id="home-seo-title">A practical guide to using an online ruler</h2>
				<div class="home-seo-copy">
					<p>An online ruler makes it easy to check the length of a small object when a physical ruler is not nearby. This free online ruler runs in your browser on a phone, tablet, or computer, with no app to install and no account to create. Open the ruler workspace, choose a unit, calibrate the display, and line up the object with zero. Read the mark beside its other end to get a quick measurement for crafts, schoolwork, packages, and everyday checks.</p>
					<h3>Measure in inches, centimeters, and millimeters</h3>
					<p>Choose online ruler inches when you are following a project or product dimension written in inches. Switch to online ruler in cm for metric measurements, or use the online ruler mm scale when you need to read smaller divisions. The controls let you move between inches, centimeters, and pixels in the workspace. Whether you searched for an online ruler cm, an online ruler in mm, or a mm online ruler, you can select the unit that matches the measurement you need without converting it first. One inch equals 2.54 centimeters, and each centimeter contains ten millimeters.</p>
					<h3>Calibrate for actual-size measurements</h3>
					<p>A screen ruler can only represent real-world length accurately when its scale is calibrated for the display you are using. Screen sizes, pixel density, browser zoom, and device settings vary, so an automatic estimate may not match a physical ruler. Use a device preset as a starting point, enter your display details, or align the on-screen guide with a standard card or known ruler. After calibration, an online ruler actual size view can serve for everyday estimates. For an online ruler inches actual size or an online ruler to scale, keep browser zoom unchanged and check the calibration again whenever you switch devices or adjust display settings.</p>
					<h3>Use a 12 inch online ruler on your device</h3>
					<p>Looking for a 12 inch online ruler or online ruler 12 inch scale? The workspace lets you view and adjust a long scale, then scroll along it on a smaller screen to reach the section you need. A phone screen may show only part of the ruler at once, while a larger monitor can display more of it. Select inches, calibrate the display, and compare the scale with a known length before relying on it. The same online ruler tool can also show centimeters and pixels, so it works for different tasks and reference systems.</p>
					<h3>What this screen ruler can and cannot measure</h3>
					<p>This real online ruler displays a scale on your screen; it does not use your camera to measure objects in a photograph. If you searched for an online ruler camera, no camera access is needed here: place the object beside the visible screen scale instead. The ruler can be positioned along different screen edges, and the workspace offers crosshair coordinates for convenient on-screen checks. A calibrated display can be useful for rough sizing, but browser-based measurement is not a replacement for a precision instrument. For tight tolerances, safety-critical work, or valuable materials, confirm the result with a physical ruler or caliper.</p>
					<h3>A simple ruler for quick checks</h3>
					<p>Start by opening the workspace and selecting inches or centimeters. Calibrate the scale against a known reference, place the item beside its zero point, and read the endpoint. Recheck your setup if browser zoom changes, the browser window moves to another monitor, or you begin using another device. You can use the same steps for a quick package check, a craft measurement, or a classroom demonstration. The goal is a convenient, accessible scale that is ready when you need it. With a careful setup, this online ruler provides a useful actual-size reference right in your browser, wherever you have a screen available.</p>
				</div>
			</section>

			<section class="home-faq" id="faq" aria-labelledby="home-faq-title">
				<div class="eyebrow">QUICK ANSWERS</div>
				<h2 id="home-faq-title">Online ruler FAQs</h2>
				{faqItems.map(({ question, answer }) => <details><summary>{question}</summary><p>{answer}</p></details>)}
			</section>
			<script type="application/ld+json" set:html={JSON.stringify(faqStructuredData)}></script>
			</div>
		</main>

		<footer class="home-footer">
			<div class="home-footer-branding">
				<a class="brand" href="/" aria-label="A Online Ruler home">
					<img class="brand-logo" src="/favicon.svg" alt="" aria-hidden="true" />
					<span>A Online Ruler</span>
				</a>
				<span class="home-copyright">&copy; 2026</span>
			</div>
			<nav aria-label="Legal and support links">
				<a href="/ruler">Ruler</a>
				<a href="/blog">Blog</a>
				<a href="/about-us">About us</a>
				<a href="/contact-us">Contact us</a>
				<a href="/privacy-policy">Privacy policy</a>
				<a href="/terms-and-conditions">Terms &amp; conditions</a>
			</nav>
		</footer>
	</div>
</Layout>

<script>
	const themeToggle = document.querySelector<HTMLButtonElement>('#home-theme-toggle');
	const themeIcon = document.querySelector<HTMLElement>('#home-theme-icon');
	if (themeToggle && themeIcon) {
		let theme = 'light';
		try { theme = localStorage.getItem('aor-theme') === 'dark' ? 'dark' : 'light'; } catch { /* Keep light mode when storage is unavailable. */ }
		const setTheme = (nextTheme: string) => {
			theme = nextTheme;
			document.documentElement.dataset.theme = theme;
			const dark = theme === 'dark';
			themeToggle.setAttribute('aria-checked', String(dark));
			themeToggle.setAttribute('aria-label', dark ? 'Dark mode' : 'Light mode');
			themeToggle.title = dark ? 'Dark mode' : 'Light mode';
			themeIcon.textContent = dark ? '☾' : '☀';
			document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')?.setAttribute('content', dark ? '#0c0c0d' : '#fafafa');
			try { localStorage.setItem('aor-theme', theme); } catch { /* Keep the preference for this session. */ }
		};
		setTheme(theme);
		themeToggle.addEventListener('click', () => setTheme(theme === 'dark' ? 'light' : 'dark'));
	}
</script>
