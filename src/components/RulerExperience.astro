	}));
	updateCardPreview();
	const calibrationInstructions = document.querySelector<HTMLElement>('#calibration-instructions')!;
	const tabCopy: Record<string, string> = {
		auto: 'Use your browser’s display information for a quick starting estimate.',
		device: 'Choose your display size to estimate its pixel density.',
		diagonal: 'Enter your screen diagonal and aspect ratio for a tailored estimate.',
		card: 'Hold a credit/debit card against the screen and adjust the slider until the outline matches exactly. This is the most accurate method.'
	};
	document.querySelectorAll<HTMLButtonElement>('[data-calibration-tab]').forEach((tab) => tab.addEventListener('click', () => {
		const method = tab.dataset.calibrationTab!;
		document.querySelectorAll('[data-calibration-tab]').forEach((item) => item.setAttribute('aria-selected', String(item === tab)));
		document.querySelectorAll<HTMLElement>('[data-method-card]').forEach((card) => {
			const key = card.dataset.methodCard;
			card.hidden = method === 'device' ? key !== 'auto' : key !== method;
		});
		document.querySelector<HTMLElement>('.app-shell')?.setAttribute('data-calibration-method', method);
		calibrationModal.dataset.calibrationMethod = method;
		calibrationInstructions.textContent = tabCopy[method];
		if (method === 'card') activate('card');
	}));
	const profileList = document.querySelector<HTMLElement>('#saved-profile-list')!;
	function renderProfiles() {
		let profiles: Array<{ name: string; ppi: number }> = [];
		try { profiles = JSON.parse(localStorage.getItem('aor-calibration-profiles') || '[]'); } catch { profiles = []; }
		profileList.replaceChildren();
		if (!profiles.length) { const empty = document.createElement('em'); empty.textContent = 'No saved profiles yet.'; profileList.append(empty); return; }
		profiles.forEach((profile) => {
			const button = document.createElement('button'); button.type = 'button'; button.className = 'saved-profile'; button.textContent = `${profile.name} · ${profile.ppi.toFixed(2)} PPI`;
			button.addEventListener('click', () => { pixelsPerCm = profile.ppi / 2.54; saveCalibration(); updateScale(); status.textContent = `${profile.name} profile applied`; });
