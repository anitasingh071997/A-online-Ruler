</Layout>

<script>
	import { translateText } from '../data/siteTranslations';
	const pageLocale = document.documentElement.lang;
	const tx = (source: string) => translateText(pageLocale, source);
	const frame = document.querySelector<HTMLElement>('#ruler-frame')!;
	const scale = document.querySelector<HTMLElement>('#scale-ruler')!;
	const status = document.querySelector<HTMLElement>('#calibration-status')!;
	const lengthLabel = document.querySelector<HTMLElement>('#length-label')!;
	const line = document.querySelector<HTMLElement>('#measurement-line')!;
	const deviceInfo = document.querySelector<HTMLElement>('#device-info')!;
	const cardAlign = document.querySelector<HTMLElement>('#card-align')!;
	const cardWidth = document.querySelector<HTMLInputElement>('#card-width')!;
	const alignReference = document.querySelector<HTMLElement>('#align-reference')!;
	const screenRulers = document.querySelector<HTMLElement>('#screen-rulers')!;
	const edgeScales = document.querySelectorAll<HTMLElement>('[data-edge-scale]');
	const manualDevice = document.querySelector<HTMLSelectElement>('#manual-device')!;
	const customDevice = document.querySelector<HTMLElement>('#custom-device')!;
	const measurementReadout = document.querySelector<HTMLElement>('#measurement-readout')!;
	const coordinateLayer = document.querySelector<HTMLElement>('#coordinate-layer')!;
	const coordinateLineX = document.querySelector<HTMLElement>('#coordinate-line-x')!;
	const coordinateLineY = document.querySelector<HTMLElement>('#coordinate-line-y')!;
	const coordinateLabel = document.querySelector<HTMLElement>('#coordinate-label')!;
	const topScreenRuler = document.querySelector<HTMLElement>('[data-screen-edge="top"]')!;
	const bottomScreenRuler = document.querySelector<HTMLElement>('[data-screen-edge="bottom"]')!;
	const leftScreenRuler = document.querySelector<HTMLElement>('[data-screen-edge="left"]')!;
	const rightScreenRuler = document.querySelector<HTMLElement>('[data-screen-edge="right"]')!;
	const calibrationSection = document.querySelector<HTMLElement>('#calibration')!;
	const calibrationSlot = document.querySelector<HTMLElement>('#calibration-slot')!;
	const calibrationModal = document.querySelector<HTMLDialogElement>('#calibration-modal')!;
	const calibrationModalBody = document.querySelector<HTMLElement>('#calibration-modal-body')!;
	let stored: string | null = null;
	try { stored = localStorage.getItem('aor-calibration'); } catch { /* Storage may be disabled in private browsing. */ }
	const storedPixelsPerCm = stored === null ? Number.NaN : Number(stored);
	// Ignore stale or malformed local storage so the scale always starts with usable dimensions.
	let pixelsPerCm = Number.isFinite(storedPixelsPerCm) && storedPixelsPerCm >= 1 && storedPixelsPerCm <= 1000
		? storedPixelsPerCm
		: 37.8;
	let unit: 'cm' | 'in' | 'px' = 'cm';
	let lengthCm = 30;
	let activeEdge = 'top';
	let lastCoordinate: { x: number; y: number } | null = null;
	let lastPointer: { x: number; y: number } = { x: window.innerWidth / 2, y: window.innerHeight / 2 };
	let guidelinesEnabled = false;
	let crosshairEnabled = false;
	let coordinatePinned = false;
	const guidelinesButton = document.querySelector<HTMLButtonElement>('#toggle-guidelines')!;
	const crosshairButton = document.querySelector<HTMLButtonElement>('#toggle-crosshair')!;
	deviceInfo.textContent = `Browser sees ${window.screen.width} screen pixels wide`;
	const deviceHelp = document.querySelector<HTMLElement>('#device-help')!;
	deviceHelp.textContent = `Your display scaling is ${window.devicePixelRatio}×. This means each browser pixel uses about ${window.devicePixelRatio} physical screen pixels. Choose your screen size below for a better estimate.`;
	function formatCoordinate(pixels: number) {
		if (unit === 'px') return `${Math.round(pixels)} px`;
		const physical = pixels / (pixelsPerCm * (unit === 'cm' ? 1 : 2.54));
		return `${physical.toFixed(unit === 'cm' ? 1 : 2)} ${unit}`;
	}
	function showCoordinate(x: number, y: number) {
		lastCoordinate = { x, y };
		const topRect = topScreenRuler.getBoundingClientRect();
		const bottomRect = bottomScreenRuler.getBoundingClientRect();
		const leftRect = leftScreenRuler.getBoundingClientRect();
		const rightRect = rightScreenRuler.getBoundingClientRect();
		coordinateLineX.style.display = y < topRect.bottom || y >= bottomRect.top ? 'none' : '';
		coordinateLineX.style.top = `${y}px`;
		coordinateLineY.style.display = x < leftRect.right || x >= rightRect.left ? 'none' : '';
		coordinateLineY.style.left = `${x}px`;
		coordinateLabel.textContent = `X ${formatCoordinate(x)} · Y ${formatCoordinate(y)}`;
		coordinateLabel.style.left = `${Math.max(leftRect.right + 8, Math.min(x + 12, rightRect.left - coordinateLabel.offsetWidth - 8))}px`;
		coordinateLabel.style.top = `${Math.max(topRect.bottom + 8, Math.min(y + 12, bottomRect.top - coordinateLabel.offsetHeight - 8))}px`;
		coordinateLayer.classList.add('is-visible');
	}
	function hideCoordinate() {
		lastCoordinate = null;
		coordinateLayer.classList.remove('is-visible');
	}

	function applyScaleMetrics(target: HTMLElement, unitWidth: number, scaleWidth: number, minorStep: number) {
		target.style.setProperty('--unit-width', `${unitWidth}px`);
		target.style.setProperty('--scale-width', `${scaleWidth}px`);
		target.style.setProperty('--minor-step', `${minorStep}px`);
	}
	function updateScale() {
		const ppiReadout = document.querySelector<HTMLOutputElement>('#calibration-ppi');
		if (ppiReadout) ppiReadout.value = (pixelsPerCm * 2.54).toFixed(2);
		const ppu = unit === 'px' ? 1 : pixelsPerCm * (unit === 'cm' ? 1 : 2.54);
		const unitWidth = unit === 'px' ? 100 : ppu;
		const scaleWidth = unit === 'px' ? lengthCm * pixelsPerCm : ppu * lengthCm / (unit === 'cm' ? 1 : 2.54);
		const markCount = unit === 'px' ? Math.ceil(scaleWidth / 100) : unit === 'cm' ? lengthCm : Math.ceil(lengthCm / 2.54);
		const minorStep = unit === 'px' ? 10 : ppu / (unit === 'cm' ? 10 : 8);
		applyScaleMetrics(screenRulers, unitWidth, scaleWidth, minorStep);
		applyScaleMetrics(scale, unitWidth, scaleWidth, minorStep);
		document.querySelectorAll<HTMLElement>('.mark-number').forEach((el, i) => {
			el.textContent = unit === 'px' ? `${i * 100}` : `${i}`;
		});
		document.querySelectorAll<HTMLElement>('.major-mark').forEach((el, i) => {
			el.hidden = i > markCount;
		});
		const shown = unit === 'cm' ? lengthCm : unit === 'in' ? lengthCm / 2.54 : Math.round(scaleWidth);
		lengthLabel.textContent = `${shown.toFixed(unit === 'cm' ? 0 : unit === 'px' ? 0 : 1)} ${unit}`;
		document.querySelector<HTMLElement>('#unit-start')!.textContent = unit;
		document.querySelector<HTMLElement>('#ruler-length')!.textContent = unit === 'px' ? `${Math.round(scaleWidth)} px · ${lengthCm} cm` : `${lengthCm} cm · ${(lengthCm / 2.54).toFixed(2)} in`;
		scale.setAttribute('aria-label', `Ruler scale from zero to ${shown.toFixed(1)} ${unit}`);
		edgeScales.forEach((edgeScale) => {
			applyScaleMetrics(edgeScale, unitWidth, scaleWidth, minorStep);
			const edge = edgeScale.closest<HTMLElement>('[data-screen-edge]')?.dataset.screenEdge;
			const viewportLength = edge === 'left' || edge === 'right' ? window.innerHeight : window.innerWidth;
			const edgeMarkCount = Math.ceil(viewportLength / unitWidth);
			edgeScale.querySelectorAll<HTMLElement>('.screen-number').forEach((label, i) => { label.textContent = unit === 'px' ? `${i * 100}` : `${i}`; });
			edgeScale.querySelectorAll<HTMLElement>('.screen-mark').forEach((mark, i) => { mark.hidden = i > edgeMarkCount; });
		});
		if (lastCoordinate) showCoordinate(lastCoordinate.x, lastCoordinate.y);
	}
	function saveCalibration() {
		try { localStorage.setItem('aor-calibration', String(pixelsPerCm)); }
		catch { status.textContent = 'Calibration active for this session'; }
	}
	function getDisplayWidthInches(diagonal: number, aspect: string) {
		let [ratioWidth, ratioHeight] = aspect.split('/').map(Number);
		const portrait = window.screen.width < window.screen.height;
		if ((portrait && ratioWidth > ratioHeight) || (!portrait && ratioWidth < ratioHeight)) {
			[ratioWidth, ratioHeight] = [ratioHeight, ratioWidth];
		}
		return diagonal * ratioWidth / Math.hypot(ratioWidth, ratioHeight);
	}
	const diagonalInput = document.querySelector<HTMLInputElement>('#diagonal')!;
	const aspectSelect = document.querySelector<HTMLSelectElement>('#aspect')!;
	function syncAspectToDisplay() {
		const displayRatio = Math.max(window.screen.width, window.screen.height) / Math.min(window.screen.width, window.screen.height);
		const closestRatio = Array.from(aspectSelect.options).reduce((closest, option) => {
			const [width, height] = option.value.split('/').map(Number);
			const ratio = width / height;
			return Math.abs(Math.log(ratio / displayRatio)) < Math.abs(Math.log(closest / displayRatio)) ? ratio : closest;
		}, Number(aspectSelect.options[0].value.split('/')[0]) / Number(aspectSelect.options[0].value.split('/')[1]));
		const matchingOption = Array.from(aspectSelect.options).find((option) => {
			const [width, height] = option.value.split('/').map(Number);
			return width / height === closestRatio;
		});
		if (matchingOption) aspectSelect.value = matchingOption.value;
	}
	diagonalInput.addEventListener('input', syncAspectToDisplay);
	window.addEventListener('resize', syncAspectToDisplay);
	syncAspectToDisplay();
	updateScale();
	window.addEventListener('resize', updateScale);
	if (Number.isFinite(storedPixelsPerCm) && storedPixelsPerCm >= 1 && storedPixelsPerCm <= 1000) status.textContent = 'Saved calibration loaded';

	document.querySelectorAll<HTMLButtonElement>('[data-unit]').forEach((button) => button.addEventListener('click', () => {
		unit = button.dataset.unit as 'cm' | 'in' | 'px';
		document.querySelectorAll('[data-unit]').forEach((item) => { item.classList.toggle('is-active', item === button); item.setAttribute('aria-pressed', String(item === button)); });
		updateScale();
	}));
	function syncGuideControls() {
		guidelinesButton.setAttribute('aria-pressed', String(guidelinesEnabled));
		crosshairButton.setAttribute('aria-pressed', String(crosshairEnabled));
		guidelinesButton.classList.toggle('is-on', guidelinesEnabled);
		crosshairButton.classList.toggle('is-on', crosshairEnabled);
		if (guidelinesEnabled || crosshairEnabled) showCoordinate(lastPointer.x, lastPointer.y);
		else hideCoordinate();
	}
	guidelinesButton.addEventListener('click', () => {
		guidelinesEnabled = !guidelinesEnabled;
		coordinatePinned = false;
		syncGuideControls();
	});
	crosshairButton.addEventListener('click', () => {
		crosshairEnabled = !crosshairEnabled;
		coordinatePinned = false;
		if (crosshairEnabled) lastPointer = { x: window.innerWidth / 2, y: window.innerHeight / 2 };
		syncGuideControls();
	});
	document.addEventListener('pointermove', (event) => {
		lastPointer = { x: event.clientX, y: event.clientY };
		if ((guidelinesEnabled || crosshairEnabled) && !coordinatePinned) showCoordinate(event.clientX, event.clientY);
	});
	document.addEventListener('click', (event) => {
		const target = event.target as HTMLElement;
		if (target.closest('a, button, input, select, textarea, summary, details, [contenteditable="true"]')) return;
		lastPointer = { x: event.clientX, y: event.clientY };
		if (crosshairEnabled || guidelinesEnabled) {
			// Every ruler-area click moves the pin; pointer movement stays free to update lastPointer only.
			showCoordinate(event.clientX, event.clientY);
			coordinatePinned = true;
		}
		else hideCoordinate();
	}, true);
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') {
			guidelinesEnabled = false;
			crosshairEnabled = false;
			coordinatePinned = false;
			syncGuideControls();
			if (document.fullscreenElement) document.exitFullscreen();
		}
		if (!event.metaKey && !event.ctrlKey && !event.altKey && !['INPUT', 'SELECT', 'TEXTAREA'].includes((event.target as HTMLElement).tagName)) {
			const shortcut = event.key.toLowerCase();
			if (shortcut === 'f') { event.preventDefault(); toggleFullscreen(); }
			if (shortcut === 'd') { event.preventDefault(); setTheme('dark'); }
			if (shortcut === 'l') { event.preventDefault(); setTheme('light'); }
			if (shortcut === 'g') { event.preventDefault(); guidelinesButton.click(); }
			if (shortcut === 'c' || shortcut === 'x') { event.preventDefault(); crosshairButton.click(); }
			const calibrationPath = pageLocale === 'en' ? '/calibration' : `/${pageLocale}/calibration`;
			if (shortcut === 'k' && window.location.pathname !== calibrationPath) { event.preventDefault(); window.location.assign(calibrationPath); }
		}
	});
	document.querySelectorAll<HTMLButtonElement>('[data-edge]').forEach((button) => button.addEventListener('click', () => {
		activeEdge = button.dataset.edge!;
		frame.dataset.position = activeEdge;
		screenRulers.dataset.activeEdge = activeEdge;
		status.textContent = `${activeEdge[0].toUpperCase()}${activeEdge.slice(1)} edge selected`;
		document.querySelectorAll('[data-edge]').forEach((item) => { item.classList.toggle('is-selected', item === button); item.setAttribute('aria-pressed', String(item === button)); });
		document.querySelectorAll<HTMLElement>('[data-screen-edge]').forEach((item) => {
			const selected = item.dataset.screenEdge === activeEdge;
			item.classList.toggle('is-edge-visible', selected);
			item.classList.toggle('is-highlighted', selected);
		});
	}));
	document.querySelector<HTMLButtonElement>('#shorter')!.addEventListener('click', () => { lengthCm = Math.max(10, lengthCm - 5); updateScale(); });
	document.querySelector<HTMLButtonElement>('#longer')!.addEventListener('click', () => { lengthCm = Math.min(50, lengthCm + 5); updateScale(); });
	const fullscreenButton = document.querySelector<HTMLButtonElement>('#fullscreen')!;
	const rulerFullscreenButton = document.querySelector<HTMLButtonElement>('#ruler-fullscreen')!;
	const fullscreenPath = document.querySelector<SVGPathElement>('#fullscreen-icon-path')!;
	const rulerFullscreenPath = document.querySelector<SVGPathElement>('#ruler-fullscreen-icon-path')!;
	function updateFullscreenButton() {
		const isFullscreen = Boolean(document.fullscreenElement);
		fullscreenButton.classList.toggle('is-fullscreen', isFullscreen);
		fullscreenButton.setAttribute('aria-label', isFullscreen ? 'Exit fullscreen' : 'Enter fullscreen');
		fullscreenButton.title = isFullscreen ? 'Exit fullscreen' : 'Enter fullscreen';
		rulerFullscreenButton.setAttribute('aria-label', isFullscreen ? 'Exit fullscreen' : 'Enter fullscreen');
		rulerFullscreenButton.title = isFullscreen ? 'Exit fullscreen (Esc)' : 'Enter fullscreen (F)';
		const enterFullscreenIcon = 'M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z';
		const exitFullscreenIcon = 'M5 16h3v3h2v-5H5v2zm3-8H5v2h5V5H8v3zm6 11h2v-3h3v-2h-5v5zm2-11V5h-2v5h5V8h-3z';
		fullscreenPath.setAttribute('d', isFullscreen ? exitFullscreenIcon : enterFullscreenIcon);
		rulerFullscreenPath.setAttribute('d', isFullscreen ? exitFullscreenIcon : enterFullscreenIcon);
	}
	async function toggleFullscreen() {
		if (!document.fullscreenElement) await document.documentElement.requestFullscreen(); else await document.exitFullscreen();
	}
	fullscreenButton.addEventListener('click', toggleFullscreen);
	rulerFullscreenButton.addEventListener('click', toggleFullscreen);
	document.addEventListener('fullscreenchange', updateFullscreenButton);
	document.querySelectorAll<HTMLDetailsElement>('.category-menu').forEach((menu) => menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { menu.open = false; })));
	function updateMeasurement(position: number, announce = false) {
		const vertical = frame.dataset.position === 'left' || frame.dataset.position === 'right';
		const size = vertical ? scale.clientHeight : scale.clientWidth;
		const clamped = Math.max(0, Math.min(position, size));
		line.style.setProperty('--line-position', `${clamped}px`);
		line.classList.add('visible');
		if (announce && size > 0) {
			const distance = unit === 'px' ? clamped : clamped / (unit === 'cm' ? pixelsPerCm : pixelsPerCm * 2.54);
			measurementReadout.textContent = `Measurement at ${distance.toFixed(unit === 'px' ? 0 : 1)} ${unit}`;
		}
	}
	scale.addEventListener('pointermove', (event) => {
		const rect = scale.getBoundingClientRect();
		const vertical = frame.dataset.position === 'left' || frame.dataset.position === 'right';
		const offset = vertical ? event.clientY - rect.top + scale.scrollTop : event.clientX - rect.left + scale.scrollLeft;
		updateMeasurement(offset);
	});
	scale.addEventListener('pointerleave', () => line.classList.remove('visible'));
	scale.addEventListener('keydown', (event) => {
		const vertical = frame.dataset.position === 'left' || frame.dataset.position === 'right';
		const step = unit === 'px' ? 10 : unit === 'cm' ? pixelsPerCm / 10 : pixelsPerCm * 2.54 / 8;
		const current = Number.parseFloat(line.style.getPropertyValue('--line-position')) || 0;
		const max = vertical ? scale.clientHeight : scale.clientWidth;
		let next = current;
		if (event.key === 'Home') next = 0;
		else if (event.key === 'End') next = max;
		else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next -= step;
		else if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next += step;
		else return;
		event.preventDefault();
		updateMeasurement(next, true);
	});
	const activate = (method: string) => {
		if (method === 'auto') {
			// CSS pixel density is only a convenient baseline; browser APIs cannot report true panel size.
			pixelsPerCm = 96 / 2.54;
			status.textContent = 'Quick estimate applied · compare with a physical object';
		} else if (method === 'diagonal') {
			const diagonalInput = document.querySelector<HTMLInputElement>('#diagonal')!;
			const diagonal = diagonalInput.valueAsNumber;
			if (!Number.isFinite(diagonal) || diagonal < 5 || diagonal > 100) { status.textContent = 'Enter a screen diagonal between 5 and 100 inches'; diagonalInput.focus(); return; }
			const widthInches = getDisplayWidthInches(diagonal, document.querySelector<HTMLSelectElement>('#aspect')!.value);
			pixelsPerCm = window.screen.width / (widthInches * 2.54);
			status.textContent = 'Diagonal estimate applied · browser zoom can affect accuracy';
		} else if (method === 'manual') {
			let diagonal: number;
			let aspect: string;
			if (manualDevice.value === 'custom') {
				const manualDiagonal = document.querySelector<HTMLInputElement>('#manual-diagonal')!;
				diagonal = manualDiagonal.valueAsNumber;
				aspect = document.querySelector<HTMLSelectElement>('#manual-aspect')!.value;
				if (!Number.isFinite(diagonal) || diagonal < 4 || diagonal > 100) { status.textContent = 'Enter a display diagonal between 4 and 100 inches'; manualDiagonal.focus(); return; }
			} else {
				const [size, ratio = '16/9'] = manualDevice.value.split('|');
				diagonal = Number(size);
				aspect = ratio;
			}
			const widthInches = getDisplayWidthInches(diagonal, aspect);
			pixelsPerCm = window.screen.width / (widthInches * 2.54);
			status.textContent = `Manual display estimate applied · ${diagonal}″, ${aspect.replace('/', ':')}`;
			const instructions = document.querySelector<HTMLElement>('#calibration-instructions');
			if (instructions) instructions.textContent = `Display estimate applied · ${diagonal}″, ${aspect.replace('/', ':')}. You can refine it with another method.`;
		} else {
			cardAlign.hidden = false;
			cardAlign.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
			return;
		}
		saveCalibration();
		document.querySelectorAll<HTMLElement>('[data-method-card]').forEach((card) => card.classList.toggle('selected', card.dataset.methodCard === method));
		updateScale();
	};
	document.querySelectorAll<HTMLButtonElement>('[data-calibrate]').forEach((button) => button.addEventListener('click', () => activate(button.dataset.calibrate!)));
	document.querySelector<HTMLButtonElement>('#apply-device')!.addEventListener('click', () => activate('manual'));
	manualDevice.addEventListener('change', () => { customDevice.hidden = manualDevice.value !== 'custom'; });
	let cardOrientation: 'horizontal' | 'vertical' = 'horizontal';
	const cardSizeLabel = document.querySelector<HTMLElement>('.align-card-size')!;
	const cardWidthValue = document.querySelector<HTMLOutputElement>('#card-width-value')!;
	let cardPpiEstimate = Number(cardWidth.value) * 25.4 / 85.6;
	function updateCardPreview(refreshEstimate = true) {
		const widthPx = Number(cardWidth.value);
		const horizontal = cardOrientation === 'horizontal';
		const heightPx = horizontal ? widthPx / 1.586 : widthPx * 1.586;
		alignReference.style.setProperty('--reference-width', `${widthPx}px`);
		alignReference.style.setProperty('--reference-height', `${heightPx}px`);
		alignReference.dataset.orientation = cardOrientation;
		document.querySelector<HTMLElement>('.align-preview-stage')!.style.setProperty('--preview-height', `${Math.max(276, heightPx + 48)}px`);
		cardSizeLabel.textContent = horizontal ? '85.60 × 53.98 mm' : '53.98 × 85.60 mm';
		const measuredWidthMm = horizontal ? 85.6 : 53.98;
		if (refreshEstimate) cardPpiEstimate = widthPx * 25.4 / measuredWidthMm;
		cardWidthValue.value = cardPpiEstimate.toFixed(1);
	}
	cardWidth.addEventListener('input', updateCardPreview);
	document.querySelectorAll<HTMLButtonElement>('[data-card-orientation]').forEach((button) => button.addEventListener('click', () => {
		const nextOrientation = button.dataset.cardOrientation as 'horizontal' | 'vertical';
		if (nextOrientation === cardOrientation) return;
		const nextWidthMm = nextOrientation === 'horizontal' ? 85.6 : 53.98;
		cardOrientation = nextOrientation;
		const nextWidth = Math.round(cardPpiEstimate * nextWidthMm / 25.4);
