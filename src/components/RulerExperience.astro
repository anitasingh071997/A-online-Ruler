		themeIcons.forEach((icon) => { icon.textContent = dark ? '☾' : '☀'; });
		document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')?.setAttribute('content', dark ? '#0c0c0d' : '#fafafa');
		try { localStorage.setItem('aor-theme', theme); } catch { /* Theme selection remains available for this session. */ }
	}
	setTheme(theme);
	themeToggles.forEach((toggle) => toggle.addEventListener('click', () => setTheme(theme === 'dark' ? 'light' : 'dark')));
	const openCalibration = document.querySelector<HTMLButtonElement>('#open-calibration');
	const closeCalibration = document.querySelector<HTMLButtonElement>('#close-calibration');
	function closeCalibrationModal() {
		if (calibrationSection.parentElement === calibrationModalBody) calibrationSlot.append(calibrationSection);
		if (calibrationModal.open) calibrationModal.close();
		delete calibrationModal.dataset.calibrationMethod;
		calibrationModal.classList.remove('app-shell', 'calibration-experience');
	}
	openCalibration?.addEventListener('click', () => {
		calibrationModal.classList.add('app-shell', 'calibration-experience');
		calibrationModal.dataset.calibrationMethod = 'auto';
		calibrationModalBody.append(calibrationSection);
		calibrationModal.showModal();
	});
	closeCalibration?.addEventListener('click', closeCalibrationModal);
	calibrationModal.addEventListener('click', (event) => { if (event.target === calibrationModal) closeCalibrationModal(); });
	calibrationModal.addEventListener('cancel', closeCalibrationModal);
</script>

