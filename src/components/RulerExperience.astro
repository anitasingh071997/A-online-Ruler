---
import Layout from '../layouts/Layout.astro';
import { faqItems, faqStructuredData } from '../data/faq';
import LanguageSelector from './LanguageSelector.astro';

interface Props { mode?: 'ruler' | 'calibration'; locale?: string; }
const { mode = 'ruler', locale = 'en' } = Astro.props;

const marks = Array.from({ length: 301 }, (_, i) => i);
---

<Layout title={mode === 'calibration' ? 'Calibrate Your Display | A Online Ruler' : 'Online Ruler Workspace | A Online Ruler'} description={mode === 'calibration' ? 'Calibrate your display for a more accurate online ruler.' : 'Measure in inches, centimeters, and pixels with a calibrated online ruler workspace.'} canonical={`https://aonlineruler.com/${locale === 'en' ? '' : `${locale}/`}${mode === 'calibration' ? 'calibration' : 'ruler'}`} locale={locale}>
	<a class="skip-link" href="#top">Skip to main content</a>
	<div class:list={['screen-rulers is-visible', mode === 'calibration' && 'calibration-hidden']} id="screen-rulers" aria-hidden="true">
		{(['top', 'bottom', 'left', 'right'] as const).map((edge) => (
			<div class:list={['screen-edge', `screen-edge-${edge}`, edge === 'top' && 'is-edge-visible', edge === 'top' && 'is-highlighted']} data-screen-edge={edge}>
				<div class="screen-edge-scale" data-edge-scale={edge}>
					{marks.map((mark) => <div class="screen-mark" style={`--mark:${mark}`}><span class="screen-tick"></span><span class="screen-number">{mark}</span></div>)}
				</div>
			</div>
		))}
	</div>
	<div class:list={['coordinate-layer', mode === 'calibration' && 'calibration-hidden']} id="coordinate-layer" aria-hidden="true">
		<div class="coordinate-line coordinate-line-x" id="coordinate-line-x"></div>
		<div class="coordinate-line coordinate-line-y" id="coordinate-line-y"></div>
		<div class="coordinate-label" id="coordinate-label"></div>
	</div>
	<header class:list={['ruler-notch', mode === 'calibration' && 'calibration-hidden']}>
		<nav class="notch-start" aria-label="Ruler navigation">
			<a class="notch-brand" href="/" aria-label="A Online Ruler home"><img class="brand-logo" src="/favicon.svg" alt="" aria-hidden="true" /><span>A Online Ruler</span></a>
			<div class="notch-edges" role="group" aria-label="Ruler edge">
				<button class="edge-option is-selected" type="button" data-edge="top" aria-pressed="true">Top</button>
				<button class="edge-option" type="button" data-edge="bottom" aria-pressed="false">Bottom</button>
				<button class="edge-option" type="button" data-edge="left" aria-pressed="false">Left</button>
				<button class="edge-option" type="button" data-edge="right" aria-pressed="false">Right</button>
			</div>
		</nav>
		<div class="notch-actions" role="toolbar" aria-label="Ruler display controls">
			<div class="segmented" role="group" aria-label="Ruler units">
				<button class="segment is-active" type="button" data-unit="cm" aria-pressed="true">cm</button>
				<button class="segment" type="button" data-unit="in" aria-pressed="false">in</button>
				<button class="segment" type="button" data-unit="px" aria-pressed="false">px</button>
			</div>
			<div class="notch-control">
				<button class="notch-button notch-tool-button" id="toggle-guidelines" type="button" aria-label="Toggle guidelines" aria-describedby="guidelines-tooltip" aria-pressed="false" title="Toggle guidelines (G)">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h6M4 4v6m16-6h-6m6 0v6M4 20h6m-6 0v-6m16 6h-6m6 0v-6M8 12h8M12 8v8" /></svg>
				</button>
				<span class="notch-tooltip" id="guidelines-tooltip" role="tooltip">Toggle guidelines <kbd>G</kbd></span>
			</div>
			<div class="notch-control">
				<button class="notch-button notch-tool-button" id="toggle-crosshair" type="button" aria-label="Toggle crosshair" aria-describedby="crosshair-tooltip" aria-pressed="false" title="Toggle crosshair (C)">
					<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="6" /><path d="M12 2v4m0 12v4M2 12h4m12 0h4" /></svg>
				</button>
				<span class="notch-tooltip" id="crosshair-tooltip" role="tooltip">Toggle crosshair <kbd>C</kbd></span>
			</div>
			<div class="notch-control">
				<button class="notch-button notch-tool-button notch-calibration-button" id="open-calibration" type="button" aria-label="Calibrate screen" aria-keyshortcuts="K" title="Calibrate screen (K)">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7.5 7.5 4h12.8v12.8l-3.5 3.5H4zM7.5 4v16.3M11 4v3m3.5-3v3M11 7.5v3m3.5-3v3M11 11v3m3.5-3v3M11 14.5v3m3.5-3v3" /></svg>
				</button>
				<span class="notch-tooltip" role="tooltip">Calibrate screen <kbd>K</kbd></span>
			</div>
		<button class="theme-toggle site-theme-switch notch-theme-toggle" id="ruler-theme-toggle" type="button" role="switch" aria-checked="false" aria-label="Switch to dark mode" title="Switch to dark mode"><span class="site-theme-track" aria-hidden="true"><span class="site-theme-mark site-theme-sun">☀</span><span class="site-theme-mark site-theme-moon">☾</span><span class="site-theme-thumb"><span id="ruler-theme-icon">☾</span></span></span></button>
			<button class="notch-button notch-fullscreen" id="ruler-fullscreen" type="button" aria-label="Enter fullscreen" title="Enter fullscreen (F)"><svg viewBox="0 0 24 24" aria-hidden="true"><path id="ruler-fullscreen-icon-path" d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z" /></svg></button>
		</div>
	</header>
	<dialog class="calibration-modal" id="calibration-modal" aria-labelledby="calibration-title">
		<div id="calibration-modal-body"></div>
	</dialog>
	<div class:list={['app-shell', mode === 'calibration' ? 'calibration-experience' : 'ruler-experience']} data-calibration-method={mode === 'calibration' ? 'auto' : undefined}>
		<header class="topbar">
			<a class="brand" href="/" aria-label="A Online Ruler home">
				<img class="brand-logo" src="/favicon.svg" alt="" aria-hidden="true" />
				<span>A Online Ruler</span>
			</a>
			<nav aria-label="Main navigation">
				{mode !== 'calibration' && <a href="/ruler#popular-tools">Popular Tools</a>}
				{mode !== 'calibration' && <details class="category-menu">
					<summary><span>Tools</span><svg class="menu-arrow" viewBox="0 0 12 12" aria-hidden="true"><path d="m3 4.5 3 3 3-3" /></svg></summary>
					<div class="category-dropdown">
						<a href="/classroom-management-tools">Classroom Management Tools</a>
						<a href="/random-tools">Random Tools</a>
						<a href="/measurement">Measurement</a>
						<a href="/facebook-editor-utilities">Facebook Editor Utilities</a>
						<a href="/emoji-symbols">Emoji &amp; Symbols</a>
						<a href="/time-and-date">Time And Date</a>
						<a href="/utilities">Utilities</a>
						<a href="/travel">Travel</a>
						<a href="/text-tool">Text Tool</a>
						<a href="/programming">Programming</a>
						<a href="/lifestyle">Lifestyle</a>
						<a href="/blog">Blog</a>
					</div>
				</details>}
				{mode !== 'calibration' && <a href="/ruler#ruler-faq">FAQs</a>}
			</nav>
			<a class="nav-button" href="/ruler">Open ruler <span aria-hidden="true">↗</span></a>
			<button class="theme-toggle site-theme-switch" id="theme-toggle" type="button" role="switch" aria-checked="false" aria-label="Switch to dark mode" title="Switch to dark mode"><span class="site-theme-track" aria-hidden="true"><span class="site-theme-mark site-theme-sun">☀</span><span class="site-theme-mark site-theme-moon">☾</span><span class="site-theme-thumb"><span id="theme-icon">☾</span></span></span></button>
		</header>

		<main id="top">
			<section class="intro" aria-labelledby="page-title">
				<div class="eyebrow"><span class="status-dot"></span> PRECISION TOOL · RUNS IN YOUR BROWSER</div>
				<h1 id="page-title">Online ruler,<br /><span>always within reach.</span></h1>
				<p class="intro-copy">Measure real objects on your screen in inches, centimeters, and millimeter divisions. Calibrate once, choose an edge, and get started in seconds.</p>
				<div class="trust-line"><span class="checkmark">✓</span> No downloads <span class="trust-divider">·</span> No account <span class="trust-divider">·</span> Your calibration stays on this device</div>
			</section>

			<section class="workspace" id="popular-tools" aria-label="Popular tools">
				<div id="ruler">
				<div class="workspace-bar">
					<div class="workspace-title"><span class="live-indicator"></span><div><strong>Screen ruler</strong><small id="calibration-status" aria-live="polite">Ready to calibrate</small></div></div>
					<div class="workspace-actions">
						<div class="segmented unit-toggle" role="group" aria-label="Ruler units">
							<button class="segment is-active" type="button" data-unit="cm" aria-pressed="true">cm</button>
							<button class="segment" type="button" data-unit="in" aria-pressed="false">in</button>
							<button class="segment" type="button" data-unit="px" aria-pressed="false">px</button>
						</div>
						<button class="icon-button" id="fullscreen" type="button" aria-label="Enter fullscreen" title="Enter fullscreen"><svg viewBox="0 0 24 24" aria-hidden="true"><path id="fullscreen-icon-path" d="M3 3h6v6H7V5H3V3zm12 0h6v6h-4V5h-2V3zm0 12h6v6h-6v-4h2v2h2v-4h-4zm-12 0h6v6H3v-6zm2 2v2h2v-2H5z" /></svg></button>
					</div>
				</div>
				<div class="ruler-frame" id="ruler-frame" data-position="top">
					<div class="edge-strip" role="group" aria-label="Choose ruler edge">
						<button type="button" class="edge-option is-selected" data-edge="top" aria-pressed="true">Top</button>
						<button type="button" class="edge-option" data-edge="bottom" aria-pressed="false">Bottom</button>
						<button type="button" class="edge-option" data-edge="left" aria-pressed="false">Left</button>
						<button type="button" class="edge-option" data-edge="right" aria-pressed="false">Right</button>
					</div>
					<div class="scale-wrap">
						<div class="scale-ruler select-none" id="scale-ruler" role="region" tabindex="0" aria-keyshortcuts="ArrowLeft ArrowRight ArrowUp ArrowDown Home End" aria-label="Ruler scale from zero to thirty centimeters">
							{marks.map((mark) => <div class="major-mark" style={`--mark:${mark}`}><span class="tick"></span><span class="mark-number">{mark}</span></div>)}
							<div class="measurement-line" id="measurement-line" aria-hidden="true"></div>
						</div>
					</div>
					<div class="ruler-footer"><span>0 <span id="unit-start">cm</span></span><span id="ruler-length">30 cm · 11.81 in</span><span class="sr-only" id="measurement-readout" aria-live="polite"></span></div>
				</div>
				<div class="workspace-bottom">
						<p><span class="keyboard-key">↔</span> Move your cursor along the scale to measure</p>
					<div class="zoom-control"><span>Ruler length</span><button type="button" id="shorter" aria-label="Shorten ruler">−</button><strong id="length-label">30 cm</strong><button type="button" id="longer" aria-label="Lengthen ruler">+</button></div>
				</div>
				</div>
			</section>

			<div id="calibration-slot"></div>
			<section class="calibration-section" id="calibration" aria-labelledby="calibration-title">
				<div class="calibration-dialog-heading">
					<h1 id="calibration-title">Calibration</h1>
					{mode === 'calibration' ? <a class="calibration-close" href="/ruler" aria-label="Close calibration">×</a> : <button class="calibration-close" id="close-calibration" type="button" aria-label="Close calibration">×</button>}
				</div>
				<div class="ppi-readout"><span>CURRENT PPI</span><output id="calibration-ppi">92.00</output></div>
				<div class="calibration-tabs" role="tablist" aria-label="Calibration method">
					<button type="button" role="tab" aria-selected="true" data-calibration-tab="auto">Auto</button>
					<button type="button" role="tab" aria-selected="false" data-calibration-tab="device">Device</button>
					<button type="button" role="tab" aria-selected="false" data-calibration-tab="diagonal">Diagonal</button>
					<button type="button" role="tab" aria-selected="false" data-calibration-tab="card">Credit Card</button>
				</div>
				<p class="calibration-instructions" id="calibration-instructions">Use your browser’s display information for a quick starting estimate.</p>
				<div class="calibration-grid">
					<article class="cal-card selected" data-method-card="auto">
						<div class="card-top"><span class="step-number">01</span><span class="card-icon" aria-hidden="true">✳</span></div>
						<h3>Auto-detect device</h3>
						<p>Use your browser’s display information for a quick starting estimate.</p>
						<div class="method-detail"><span class="device-glyph" aria-hidden="true">▰</span><div class="device-reading"><strong id="device-info">Detecting your display…</strong><small id="device-help">This is your browser’s estimate. Choose your screen below to improve it.</small></div></div>
						<label class="device-select-label" for="manual-device">Choose your screen</label>
						<select class="device-select" id="manual-device" name="manual-device">
							<optgroup label="Phones">
							<option value="5.4|9/19.5">5.4″ phone · 19.5:9</option>
							<option value="6.1|9/19.5">6.1″ phone · 19.5:9</option>
							<option value="6.5|9/20">6.5″ phone · 20:9</option>
							<option value="6.7|9/20">6.7″ phone · 20:9</option>
							</optgroup>
							<optgroup label="Tablets">
								<option value="8.3|3/2">8.3″ tablet · 3:2</option>
								<option value="10.9|4/3">10.9″ tablet · 4:3</option>
								<option value="11|3/2">11″ tablet · 3:2</option>
							</optgroup>
							<optgroup label="Laptops">
							<option value="13.3|16/9">13.3″ laptop · 16:9</option>
							<option value="13.6|3/2">13.6″ laptop · 3:2</option>
							<option value="14|16/10">14″ laptop · 16:10</option>
							<option value="15.6|16/9" selected>15.6″ laptop · 16:9</option>
							<option value="16|16/10">16″ laptop · 16:10</option>
							<option value="17.3|16/9">17.3″ laptop · 16:9</option>
							</optgroup>
							<optgroup label="Monitors">
							<option value="21.5|16/9">21.5″ monitor · 16:9</option>
							<option value="24|16/9">24″ monitor · 16:9</option>
							<option value="27|16/9">27″ monitor · 16:9</option>
							<option value="32|16/9">32″ monitor · 16:9</option>
							<option value="34|21/9">34″ ultrawide · 21:9</option>
							</optgroup>
							<optgroup label="Custom">
							<option value="custom">Custom screen…</option>
							</optgroup>
						</select>
						<div class="custom-device" id="custom-device" hidden>
							<label for="manual-diagonal">Screen size, measured corner to corner</label>
							<div class="custom-device-fields"><input id="manual-diagonal" type="number" min="4" max="100" step="0.1" value="15.6" name="manual-diagonal" inputmode="decimal" autocomplete="off" /><span>inches</span><select id="manual-aspect" name="manual-aspect" aria-label="Display aspect ratio"><option value="16/9">16:9</option><option value="16/10">16:10</option><option value="3/2">3:2</option><option value="4/3">4:3</option><option value="21/9">21:9</option><option value="9/19.5">19.5:9 phone</option><option value="9/20">20:9 phone</option></select></div>
						</div>
						<button class="card-button secondary manual-device-button" id="apply-device" type="button">Use this screen <span aria-hidden="true">→</span></button>
						<button class="card-button primary" type="button" data-calibrate="auto">Use quick estimate <span aria-hidden="true">→</span></button>
						<small class="fine-print">Best for a quick start. Fine-tune with a known-size object.</small>
					</article>
					<article class="cal-card" data-method-card="diagonal" hidden={mode === 'calibration'}>
						<div class="card-top"><span class="step-number">02</span><span class="card-icon" aria-hidden="true">⌁</span></div>
						<h3>Screen diagonal</h3>
						<p>Enter your display’s diagonal size and aspect ratio for a tailored estimate.</p>
						<div class="inline-fields">
							<label>Diagonal <span class="input-wrap"><input id="diagonal" type="number" min="5" max="100" step="0.1" value="13.3" name="diagonal" inputmode="decimal" autocomplete="off" /><span>in</span></span></label>
							<label>Ratio <select id="aspect" name="aspect"><option value="16/9">16:9</option><option value="16/10">16:10</option><option value="3/2">3:2</option><option value="4/3">4:3</option><option value="21/9">21:9</option><option value="19.5/9">19.5:9</option><option value="20/9">20:9</option></select></label>
						</div>
						<button class="card-button secondary" type="button" data-calibrate="diagonal">Calibrate screen <span aria-hidden="true">→</span></button>
						<small class="fine-print">The ratio is estimated from your display shape and updates when you edit the diagonal. Confirm browser zoom is 100%.</small>
					</article>
					<article class="cal-card" data-method-card="card" hidden={mode === 'calibration'}>
						<div class="card-top"><span class="step-number">03</span><span class="card-icon card-icon-card" aria-hidden="true">▭</span></div>
						<h3>Credit card</h3>
						<p>Match this reference to a standard bank card for the most reliable scale.</p>
						<div class="card-reference"><div class="credit-card-visual"><span>A</span><i></i><i></i></div><div><strong>Standard card</strong><small>85.60 mm wide</small></div></div>
						<button class="card-button secondary" type="button" data-calibrate="card">Align credit card <span aria-hidden="true">→</span></button>
						<div class="card-align" id="card-align" hidden>
							{mode === 'calibration' && <div class="orientation-control" role="group" aria-label="Credit card orientation">
								<span>Card orientation</span>
								<div class="orientation-options">
									<button type="button" data-card-orientation="horizontal" aria-pressed="true">↔ <span>Horizontal</span></button>
									<button type="button" data-card-orientation="vertical" aria-pressed="false">↕ <span>Vertical</span></button>
								</div>
							</div>}
							<div class="align-preview-stage"><div class="align-reference" id="align-reference"><span class="align-card-name">CREDIT CARD</span><span class="align-card-size">85.60 × 53.98 mm</span></div></div>
							<label for="card-width">ADJUST SIZE</label>
							<input id="card-width" name="card-width" type="range" min="180" max="620" step="1" value="324" aria-label="Adjust reference card width" />
							<output class="card-width-value" id="card-width-value">96.0</output>
							<small class="slider-help">Use ← → arrow keys for fine adjustment.</small>
							<div class="align-actions"><button id="cancel-card" class="cancel-align" type="button">Cancel</button><button id="apply-card" class="apply-align" type="button">Apply calibration</button></div>
						</div>
						<small class="fine-print">Place a physical card against the screen to match its width.</small>
					</article>
				</div>
				<div class="saved-profiles"><div class="saved-profiles-heading"><h2>Saved Profiles</h2><button type="button" id="save-profile">+ Save</button></div><div id="saved-profile-list" class="saved-profile-list"><em>No saved profiles yet.</em></div></div>
				<div class="calibration-note" id="calibration-note" role="status" aria-live="polite"><span class="note-icon">i</span><span>For the most accurate measurements, compare the ruler against a standard card or physical ruler. Browser display data can only provide an estimate.</span><button id="dismiss-note" type="button" aria-label="Dismiss calibration note">×</button></div>
			</section>

			<section class="how-section" id="how-it-works">
				<div class="eyebrow">MEASURE WITH CONFIDENCE</div>
				<div class="how-grid"><h2>Simple by design.<br />Accurate by calibration.</h2><div class="how-copy"><p>Every display is different. A quick calibration aligns the ruler on your screen with the real world, so you can measure small objects without reaching for a physical ruler.</p><a href="#calibration">Choose a calibration method <span aria-hidden="true">→</span></a></div></div>
				<div class="feature-row"><div><span class="feature-index">A</span><div><strong>Choose your edge</strong><p>Keep the scale where it’s easiest to measure.</p></div></div><div><span class="feature-index">B</span><div><strong>Switch units instantly</strong><p>Toggle centimeters, inches, and pixels in one tap.</p></div></div><div><span class="feature-index">C</span><div><strong>Keep your setup</strong><p>Your calibration is saved on this device.</p></div></div></div>
			</section>

			<section class="seo-guide" id="online-ruler-guide" aria-labelledby="online-ruler-guide-title">
				<div class="eyebrow">A PRACTICAL MEASURING GUIDE</div>
				<h2 id="online-ruler-guide-title">A free online ruler for everyday measurements</h2>
				<div class="seo-guide-copy">
					<p>An online ruler turns your laptop, tablet, or phone screen into a handy measuring surface. Check a small object, compare a package, or plan a craft project. This free online ruler runs in your browser with no install or account. Choose a unit, calibrate the display, and place an object beside the scale.</p>
					<h3>Measure in inches, centimeters, and millimeters</h3>
					<p>Choose online ruler inches for imperial measurements, or switch to centimeters for metric work. The centimeter scale has ten small divisions, each representing one millimeter. This works as an online ruler in mm for short lengths, even when the main display is set to centimeters. Read the nearest mark and compare it with a physical reference when precision matters.</p>
					<p>For an online ruler cm reading, use the numbered centimeter marks first, then count the short divisions between them. Three small marks after 2 cm indicate 2.3 cm, or 23 mm. This online ruler mm reference keeps millimeter graduations visible without crowding the scale with extra labels. An mm online ruler search often means someone needs these smaller metric increments.</p>
					<p>Need a 12 inch online ruler? Select inches, extend the ruler to at least 12 inches, and use the numbered marks to read the length. The scale can be longer than a phone viewport, so swipe horizontally along the ruler to reach marks that are off-screen. On a large display, the same online ruler tool can show a longer section at once.</p>
					<h3>Calibrate the display for actual size</h3>
					<p>A screen has no universal physical size. Browser zoom, display density, and monitor dimensions affect how large a measurement looks. For an online ruler to scale, choose a device preset or enter your screen diagonal and aspect ratio. Then compare the guide with a standard card or physical ruler. Calibration is saved on this device for your next visit.</p>
					<p>Calibration is essential for an accurate online ruler. Browsers do not report the exact physical pixel density of every screen, so automatic display information is only an estimate. Compare the guide with a real object to correct it. Online ruler inches actual size describes the goal: a screen scale that matches real dimensions after calibration. Verify close tolerances with a physical tool.</p>
					<p>An actual size online ruler depends on matching the displayed scale to a known physical length. Keep browser zoom steady after calibration, since zooming changes the relationship between screen pixels and the ruler. For an online ruler to scale consistently, recalibrate whenever you move to another display or change its zoom settings.</p>
					<h3>Use the ruler on your phone or computer</h3>
					<p>This real online ruler adapts to phones and desktop monitors. Swipe across the scale to see its full length, change the ruler edge, or switch units. Phone and tablet presets offer a starting point, while custom screen fields describe other displays. A preset is an estimate; physical calibration is better when measurements must be dependable.</p>
					<p>Some people search for an online ruler camera to measure through a phone. This page needs no camera: it displays a scale, and you place the object beside it. For an online ruler mm reading, align the object with zero and use the millimeter marks. Calibrate first, and avoid changing browser zoom afterward.</p>
					<h3>What this online ruler can and cannot do</h3>
					<p>Use the ruler for school activities, crafts, model making, or quick household checks. Choose centimeters, inches, or pixels; change the visible edge; and adjust the length. The free online ruler works on desktop and mobile browsers. Calibration stays in this browser and is not uploaded.</p>
					<p>Measurements depend on calibration, zoom, and the display, so an uncalibrated screen cannot promise identical accuracy on every device. Confirm important cuts, fits, shipments, or purchases with a physical ruler or caliper. For everyday checks, this online ruler offers a quick real-size reference wherever you can open a browser.</p>
				</div>
			</section>

