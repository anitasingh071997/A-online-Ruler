		});
	}
	document.querySelector<HTMLButtonElement>('#save-profile')!.addEventListener('click', () => {
		const name = window.prompt(tx('Name this calibration profile'));
		if (!name?.trim()) return;
		let profiles: Array<{ name: string; ppi: number }> = [];
		try { profiles = JSON.parse(localStorage.getItem('aor-calibration-profiles') || '[]'); } catch { profiles = []; }
