	});
	renderProfiles();
	document.querySelector<HTMLButtonElement>('#cancel-card')!.addEventListener('click', () => { cardAlign.hidden = true; });
	document.querySelector<HTMLButtonElement>('#apply-card')!.addEventListener('click', () => {
		pixelsPerCm = Number(cardWidth.value) / (cardOrientation === 'horizontal' ? 8.56 : 5.398);
		saveCalibration();
		status.textContent = 'Credit card calibration applied';
		document.querySelectorAll<HTMLElement>('[data-method-card]').forEach((card) => card.classList.toggle('selected', card.dataset.methodCard === 'card'));
		cardAlign.hidden = true;
		updateScale();
	});
	document.querySelector<HTMLButtonElement>('#dismiss-note')!.addEventListener('click', () => document.querySelector('#calibration-note')!.remove());
	const themeToggles = Array.from(document.querySelectorAll<HTMLButtonElement>('.theme-toggle'));
	const themeIcons = Array.from(document.querySelectorAll<HTMLElement>('#theme-icon, #ruler-theme-icon'));
	let theme = 'light';
	try { theme = localStorage.getItem('aor-theme') === 'dark' ? 'dark' : 'light'; } catch { /* Theme selection remains available for this session. */ }
	function setTheme(nextTheme: string) {
		theme = nextTheme;
		document.documentElement.dataset.theme = theme;
		const dark = theme === 'dark';
