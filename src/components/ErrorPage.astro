---
import Layout from '../layouts/Layout.astro';

interface Props {
	status: string;
	title: string;
	description: string;
}

const { status, title, description } = Astro.props;
---

<Layout title={`${status} — ${title} | A Online Ruler`} description={description} robots="noindex,nofollow">
	<div class="error-shell">
		<header class="error-topbar">
			<a class="brand" href="/" aria-label="A Online Ruler home">
				<span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
				<span>A Online Ruler</span>
			</a>
			<a href="/ruler">Open ruler <span aria-hidden="true">↗</span></a>
		</header>
		<main class="error-main" aria-labelledby="error-title">
			<div class="error-status">{status}</div>
			<h1 id="error-title">{title}</h1>
			<p>{description}</p>
			<div class="error-actions">
				<a class="error-primary" href="/">Go to homepage</a>
				<a href="/ruler">Open the ruler</a>
			</div>
		</main>
		<footer class="error-footer">
			<a href="/about-us">About us</a>
			<a href="/contact-us">Contact us</a>
			<a href="/privacy-policy">Privacy policy</a>
		</footer>
	</div>
</Layout>
